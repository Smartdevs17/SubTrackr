{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadModelRegistry",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${bucket_arn}/models/registry/*"
    },
    {
      "Sid": "ListModelRegistryPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "${bucket_arn}",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["models/registry/*"]
        }
      }
    }
  ]
}
