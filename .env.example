# SubTrackr Backend - Environment Variables
# Copy this file to .env and fill in your values.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=subtrackr
DB_USER=postgres
# Required: set a strong password
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: set if Redis requires authentication
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DEFAULT_TTL_SECONDS=3600
REDIS_CONNECT_TIMEOUT_MS=5000
# Docker Compose Port Configurations (Change in your local .env to fix port conflicts)
COMPOSE_PORT_POSTGRES=5432
COMPOSE_PORT_REDIS=6379
COMPOSE_PORT_SOROBAN=8000
COMPOSE_PORT_BACKEND=3000
COMPOSE_PORT_ML=8001
COMPOSE_PORT_EXPO=8081

# Issue #600: serverless DB connection multiplexing via PgBouncer.
# Point the app at PgBouncer (:6432), not Postgres directly.
DB_PROXY_HOST=localhost
DB_PROXY_PORT=6432
DB_PROXY_AUTH_MODE=scram-256
DB_PROXY_TXN_POOLING=true
DB_PROXY_PREPARED_STATEMENTS=true
DB_PROXY_MAX_CONN=50
DB_LEAK_THRESHOLD_MS=30000

# ── Webhook Signature Verification ────────────────────────────────────────────
# HMAC-SHA256 signing key used to sign and verify outbound/inbound webhooks.
# Rotate with POST /api/v1/webhooks/rotate-key  (overlap window: 24h)
WEBHOOK_SIGNING_KEY=change-me-to-a-long-random-secret

# ── Zapier Integration ─────────────────────────────────────────────────────────
# No server-side secrets required — merchants authenticate with their API keys.
# Set this to restrict which origins can reach the Zapier endpoints.
ZAPIER_ALLOWED_ORIGINS=https://hooks.zapier.com

# ── QuickBooks Online Integration ─────────────────────────────────────────────
# Create an app at https://developer.intuit.com to get these credentials.
QB_CLIENT_ID=
QB_CLIENT_SECRET=
# Must match the redirect URI configured in the Intuit developer portal.
QB_REDIRECT_URI=http://localhost:3000/api/v1/quickbooks/callback
# 'sandbox' for development, 'production' for live data.
QB_ENVIRONMENT=sandbox

# ── Calendar Integration ───────────────────────────────────────────────────────
# Google Calendar OAuth (for server-side calendar push via service account)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/v1/calendar/google/callback

# Microsoft Outlook / Graph API
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:3000/api/v1/calendar/outlook/callback

# Renewal reminder lead times (comma-separated days before renewal)
# Default: 30,7,1  → events created 30, 7, and 1 day before each renewal.
RENEWAL_REMINDER_LEAD_DAYS=30,7,1
