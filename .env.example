# SubTrackr Backend - Environment Variables
# Copy this file to .env and fill in your values.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=subtrackr
DB_USER=postgres
# Required: set a strong password
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: set if Redis requires authentication
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DEFAULT_TTL_SECONDS=3600
REDIS_CONNECT_TIMEOUT_MS=5000
# Docker Compose Port Configurations (Change in your local .env to fix port conflicts)
COMPOSE_PORT_POSTGRES=5432
COMPOSE_PORT_REDIS=6379
COMPOSE_PORT_SOROBAN=8000
COMPOSE_PORT_BACKEND=3000
COMPOSE_PORT_ML=8001
COMPOSE_PORT_EXPO=8081

# Issue #600: serverless DB connection multiplexing via PgBouncer.
# Point the app at PgBouncer (:6432), not Postgres directly.
DB_PROXY_HOST=localhost
DB_PROXY_PORT=6432
DB_PROXY_AUTH_MODE=scram-256
DB_PROXY_TXN_POOLING=true
DB_PROXY_PREPARED_STATEMENTS=true
DB_PROXY_MAX_CONN=50
DB_LEAK_THRESHOLD_MS=30000

# ── Slack Notifications ───────────────────────────────────────────────────────
# Incoming Webhook URL from https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=
# Optional: separate webhook for critical system alerts (falls back to SLACK_WEBHOOK_URL)
SLACK_ALERTS_WEBHOOK_URL=
# Optional overrides
SLACK_USERNAME=SubTrackr
SLACK_ICON_EMOJI=:bell:
SLACK_CHANNEL=
SLACK_ALERTS_CHANNEL=

# ── Email Provider ────────────────────────────────────────────────────────────
# Provider selection: "sendgrid" (default) or "ses"
EMAIL_PROVIDER=sendgrid

# SendGrid (used when EMAIL_PROVIDER=sendgrid)
# API key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
# Set to "true" to validate emails without actually delivering them
SENDGRID_SANDBOX=false

# AWS SES (used when EMAIL_PROVIDER=ses)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: override SES endpoint (e.g. for localstack)
AWS_SES_ENDPOINT=

# Sender identity (both providers)
EMAIL_FROM_ADDRESS=noreply@subtrackr.app
EMAIL_FROM_NAME=SubTrackr

# ── Twilio SMS ────────────────────────────────────────────────────────────────
# Credentials from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 format sender number, e.g. +15017122661
TWILIO_FROM_NUMBER=
# Optional: use a Messaging Service SID instead of a single number
TWILIO_MESSAGING_SERVICE_SID=
# Optional: URL for delivery status webhooks (POST from Twilio)
TWILIO_STATUS_CALLBACK_URL=
# Optional: max SMS segments per message (default: 3)
TWILIO_MAX_SEGMENTS=3

# ── Webhook Queue (BullMQ / Redis) ────────────────────────────────────────────
# Re-uses REDIS_HOST / REDIS_PORT / REDIS_PASSWORD above.
# Queue names (defaults shown — override only if you run multiple environments)
WEBHOOK_QUEUE_NAME=subtrackr:webhooks
WEBHOOK_WORKER_CONCURRENCY=5
