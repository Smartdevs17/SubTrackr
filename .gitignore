# Test snapshots & generated test/lint artifacts
# Jest/Vitest snapshots are generated, environment-dependent and regenerate on
# demand, so committing them produces noisy diffs and stale expectations. Rust
# contract snapshots are the exception and are un-ignored further down.
**/__snapshots__/
**/snapshots/
*.snap
*.snap.orig
junit.xml
jest-results.json
test-results/
playwright-report/
e2e/artifacts/
e2e/screenshots/
_jest-cache/
.jest-cache/
test_output.txt
tsc_output*.txt
lint_output*.txt
lint_final_error.txt
final_lint_check.txt

# Load test reports
load-tests/reports/*
!load-tests/reports/.gitkeep

# React Native
.expo-shared/

# Build artifacts
build_errors*.txt
contracts/migrations/history/*
!contracts/migrations/history/.gitkeep
contracts/migrations/snapshots/*
!contracts/migrations/snapshots/.gitkeep

# Rust / Soroban test snapshots
#
# These are NOT junk: Soroban stores ledger/auth state per test case, so a
# missing snapshot means the upgrade path and timelock enforcement are no
# longer being verified. They are re-asserted below the JS snapshot rules so a
# future blanket ignore cannot silently drop them.
contracts/**/test_snapshots/
test_snapshots/
!contracts/**/test_snapshots/

# Generated / artifact files
*.orig
SubTrackr
contracts/clippy_output.txt
