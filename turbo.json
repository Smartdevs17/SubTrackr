{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig*.json",
        "**/*.ts",
        "**/*.tsx"
      ],
      "outputs": [],
      "cache": true
    }
  }
}
